# ── Neo4j AuraDB ────────────────────────────────────────────────────────────
# Create a free instance at https://console.neo4j.io
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# ── GitHub (classic token, public_repo read scope is enough) ────────────────
GITHUB_TOKEN=ghp_xxx

# ── Repo config ──────────────────────────────────────────────────────────────
REPO_OWNER=redis
REPO_NAME=redis
REPO_LOCAL_PATH=data/repo
SUBSYSTEM_PATHS=src/replication.c,src/rdb.c,src/aof.c,redis.conf
MAX_PRS=400
MAX_COMMITS=3000

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=sarvam               # anthropic | sarvam
LLM_MODEL=claude-sonnet-5-5       # only used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=                 # leave blank when using Sarvam
SARVAM_API_KEY=sk_xxx
SARVAM_MODEL=sarvam-105b

# ── Embeddings (local, no key needed) ────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── Behaviour ─────────────────────────────────────────────────────────────────
MAX_GRAPH_HOPS=3
REFUSAL_THRESHOLD=0.35
CACHE_DIR=data/cache

# ── CORS — local dev (comma-separated) ───────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Frontend (only needed for Vercel deployment) ──────────────────────────────
# Set this in Vercel Dashboard → Project → Settings → Environment Variables
# Value = your Render backend URL, e.g.:  https://intentlens-api.onrender.com
# VITE_API_URL=https://intentlens-api.onrender.com
